{
  "__meta__": {
    "key": "minimax_h3_i2v",
    "kind": "video",
    "description": "MiniMax H3 图生视频（首帧驱动，turbo 4-step LoRA 加速，24fps）。length=17k+5 帧网格，训练范围 124~362 帧（约 5~15 秒）。",
    "max_frames": 362
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    }
  },
  "11": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "prompt": "{{prompt}}",
      "width": 1376,
      "height": 768,
      "length": "{{frames}}",
      "first_frame": ["10", 0]
    }
  },
  "12": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{seed}}"
    }
  },
  "13": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "14": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["2", 0],
      "scheduler": "simple",
      "steps": 4,
      "denoise": 1.0
    }
  },
  "15": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["2", 0],
      "conditioning": ["11", 0]
    }
  },
  "16": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["12", 0],
      "guider": ["15", 0],
      "sampler": ["13", 0],
      "sigmas": ["14", 0],
      "latent_image": ["11", 1]
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["16", 0],
      "vae": ["4", 0]
    }
  },
  "18": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["17", 0],
      "fps": 24
    }
  },
  "19": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["18", 0],
      "filename_prefix": "h3_i2v",
      "format": "auto"
    }
  }
}

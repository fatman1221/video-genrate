# ===== AI Video Agent Studio · 后端配置示例 =====
# 复制为 .env 后按需修改；所有项都有合理默认值。

# ---- 应用 ----
APP_NAME=AI Video Agent Studio
HOST=127.0.0.1
PORT=8077
DEBUG=true

# ---- 数据库 ----
# PostgreSQL（默认，推荐）
DATABASE_URL=postgresql+psycopg://trade_app:change-me@127.0.0.1:5432/video_agent_studio
# 零依赖方案（SQLite）：
# DATABASE_URL=sqlite:///./video_agent_studio.db

# ---- 存储 ----
# local | s3 | oss | minio
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://127.0.0.1:8077
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---- 执行引擎 ----
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TASK_WORKERS=4

# ---- 默认 Provider ----
DEFAULT_PROVIDER_IMAGE=local
DEFAULT_PROVIDER_VIDEO=local
DEFAULT_PROVIDER_TTS=local
DEFAULT_PROVIDER_MUSIC=local
DEFAULT_PROVIDER_SFX=local
DEFAULT_PROVIDER_SUBTITLE=local
DEFAULT_PROVIDER_ENHANCE=ffmpeg

# ---- ComfyUI（可选，接入后把 DEFAULT_PROVIDER_* 改为 comfyui） ----
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=

# ---- 云端视频 / 图像 / TTS（可选） ----
CLOUD_VIDEO_BASE_URL=
CLOUD_VIDEO_API_KEY=
CLOUD_IMAGE_BASE_URL=
CLOUD_IMAGE_API_KEY=
CLOUD_TTS_BASE_URL=
CLOUD_TTS_API_KEY=

# ---- 生成默认参数 ----
DEFAULT_IMAGE_WIDTH=1280
DEFAULT_IMAGE_HEIGHT=720
DEFAULT_VIDEO_WIDTH=1280
DEFAULT_VIDEO_HEIGHT=720
DEFAULT_FPS=24
DEFAULT_SHOT_DURATION=5
TTS_VOICE=Tingting
TTS_RATE=180

# ---- 行为开关 ----
AUTO_ADVANCE_WORKFLOW=true

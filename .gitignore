# =========================================================================== #
# AI Video Agent 工作台 —— Git 忽略规则
#
# 原则：仓库只存「源码 + 文档 + 配置模板」。
#       凡是「能由源码重新生成」或「依赖本机环境」的东西都不入库。
# =========================================================================== #

# --------------------------------------------------------------------------- #
# 依赖目录（体积大，且可由 lock 文件精确还原）
# --------------------------------------------------------------------------- #
node_modules/
frontend/node_modules/
.venv/
venv/
env/
backend/.venv/

# --------------------------------------------------------------------------- #
# 本地工具链（tools/）的模型权重与虚拟环境
#   —— 权重动辄数 GB，按需从 HuggingFace 下载，不入库
#   —— venv 已由上面的 `venv/` 规则覆盖，这里再显式声明一次以防误提交
# --------------------------------------------------------------------------- #
tools/*/models/
tools/*/venv/
tools/*/outputs/

# --------------------------------------------------------------------------- #
# Python
# --------------------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --------------------------------------------------------------------------- #
# 前端构建产物与缓存
# --------------------------------------------------------------------------- #
frontend/dist/
dist/
.vite/
frontend/node_modules/.vite/
# Vite 在配置热重载时生成的临时配置文件
frontend/vite.config.js.timestamp-*.mjs

# --------------------------------------------------------------------------- #
# 运行时数据（数据库只存 file_path，文件本体在本地磁盘）
#   —— 这些是「生成结果」，换台电脑重新跑流水线即可产出
#   —— 若需要连同素材一起迁移，见 docs/MIGRATION.md
# 注意：这里必须写 `storage/*` 而不是 `storage/`。
#       git 不会进入被整体排除的目录，写 `storage/` 会让下面的
#       `!.gitkeep` 白名单失效（无法重新包含已排除目录内的文件）。
# --------------------------------------------------------------------------- #
backend/storage/*
!backend/storage/.gitkeep

# --------------------------------------------------------------------------- #
# 创作资产归档（archive/）
#   —— 角色候选图 / 定妆图 / 九视图 / 海报等**生成结果**，单个文件几 MB，
#      全部入库会让仓库永久膨胀（且 git 无法有效瘦身）。
#   —— 约定：archive/ 只作本机长期留存，需要对外分享时单独打包发送。
#      各目录附带的 README.md / index.json 会一并忽略，不影响本地查阅。
# --------------------------------------------------------------------------- #
archive/

# 流水线断点续跑的状态文件（build_project.py 产出）
#   —— 内容是本机数据库的自增 id 与阶段进度，换环境即失效，无版本价值
*.state.json

# --------------------------------------------------------------------------- #
# 敏感配置：只提交 .env.example 模板，真实 .env 不入库
# --------------------------------------------------------------------------- #
.env
.env.*
!.env.example
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
*.pem
*.key

# --------------------------------------------------------------------------- #
# AI 工作区（本机记忆 / 工作日志 / 会话产物）
#   —— 含本机绝对路径、数据库账号与内部项目信息，公开仓库不应包含
#   —— 本地文件完整保留，仅不纳入版本控制
# --------------------------------------------------------------------------- #
.workbuddy/

# --------------------------------------------------------------------------- #
# 零依赖方案（SQLite）的库文件：属运行时数据，不入库
# --------------------------------------------------------------------------- #
video_agent_studio.db
video_agent_studio.db-shm
video_agent_studio.db-wal
backend/video_agent_studio.db
backend/video_agent_studio.db-shm
backend/video_agent_studio.db-wal

# --------------------------------------------------------------------------- #
# 迁移 / 备份产物（属数据，不属源码）
# --------------------------------------------------------------------------- #
migration/
*.dump
*.sql.gz
*.bundle
backups/

# --------------------------------------------------------------------------- #
# 日志与临时文件
# --------------------------------------------------------------------------- #
*.log
logs/
*.tmp
*.temp
*.swp
*~

# --------------------------------------------------------------------------- #
# macOS
# --------------------------------------------------------------------------- #
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# --------------------------------------------------------------------------- #
# 编辑器 / IDE
# --------------------------------------------------------------------------- #
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
